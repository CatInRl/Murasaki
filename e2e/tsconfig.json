{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022", "DOM"],
    "noEmit": true
  },
  "include": ["**/*.ts", "types/**/*.d.ts"],
  "exclude": ["scripts/**"]
}
