{
  "name": "murasaki",
  "private": true,
  "version": "0.4.0",
  "description": "A local Markdown file manager and editor built with Tauri + Vue 3",
  "license": "MIT",
  "author": "CatInRl",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "powershell -ExecutionPolicy Bypass -File scripts/tauri-dev.ps1",
    "tauri:build": "powershell -ExecutionPolicy Bypass -File scripts/tauri-build.ps1",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-env.ps1",
    "setup:install": "powershell -ExecutionPolicy Bypass -File scripts/setup-env.ps1 -InstallMissing",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cd src-tauri && cargo test",
    "test:e2e:check": "powershell -ExecutionPolicy Bypass -File e2e/scripts/check-env.ps1",
    "test:e2e": "npm run test:e2e:check && vitest run --config e2e/vitest.config.ts",
    "test:e2e:watch": "vitest --config e2e/vitest.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.6",
    "@shikijs/markdown-it": "^4.3.1",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-store": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@types/diff-match-patch": "^1.0.36",
    "codemirror": "^6.0.2",
    "diff-match-patch": "^1.0.5",
    "dompurify": "^3.4.12",
    "katex": "^0.18.1",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.3.0",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^11.16.0",
    "naive-ui": "^2.40.0",
    "openai": "^6.49.0",
    "pinia": "^2.1.0",
    "shiki": "^4.3.1",
    "vue": "^3.5.0",
    "vue-i18n": "^9.14.4"
  },
  "devDependencies": {
    "@pinia/testing": "^0.1.7",
    "@tauri-apps/cli": "^2.11.4",
    "@types/markdown-it": "^14.1.2",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "tempfile": "^5.0.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.0.0",
    "webdriverio": "^9.30.0"
  }
}
